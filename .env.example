# Copy this file to .env and fill in real values before running the pipeline.
# Required for Google Calendar / Gmail integrations.
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project"}'
CALENDAR_ID='primary'
CALENDAR_TIMEZONE='America/New_York'

# Core app settings
HOME_LOCATION='Riverview, FL'
WORK_LOCATION='Tampa, FL'
SCHOOL_LOCATION='Riverview, FL'
GOLF_LOCATION='Riverview, FL'
DAYCARE_LOCATION='Riverview, FL'
BRIEFING_DAYS_AHEAD=7
AGENT_TONE='warm and practical'
DAILY_ROUTINE='School drop-offs, work blocks, and family logistics.'
BRIEFING_TITLE='Weekly Family Briefing'

# Weather / Maps
OPENWEATHER_API_KEY='your-openweather-api-key'
GOOGLE_MAPS_API_KEY='your-google-maps-api-key'

# LLM providers
ANTHROPIC_API_KEY='your-anthropic-key'
GROQ_API_KEY='your-groq-key'
GROQ_MODEL='openai/gpt-oss-20b'

# AWS / S3
AWS_ACCESS_KEY_ID='your-aws-access-key'
AWS_SECRET_ACCESS_KEY='your-aws-secret-key'
AWS_REGION='us-east-1'
S3_BUCKET='your-bucket-name'

# Email
EMAIL_SENDER='you@gmail.com'
EMAIL_RECIPIENT='family@example.com'
GMAIL_APP_PASSWORD='your-gmail-app-password'
